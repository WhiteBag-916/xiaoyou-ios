GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/ASIHTTPRequest" "${PODS_ROOT}/Headers/Public/CocoaLumberjack" "${PODS_ROOT}/Headers/Public/EaseMobSDK" "${PODS_ROOT}/Headers/Public/FMDB" "${PODS_ROOT}/Headers/Public/KLCircleViewController" "${PODS_ROOT}/Headers/Public/MJExtension" "${PODS_ROOT}/Headers/Public/MJRefresh" "${PODS_ROOT}/Headers/Public/Masonry" "${PODS_ROOT}/Headers/Public/Reachability" "${PODS_ROOT}/Headers/Public/RegExCategories" "${PODS_ROOT}/Headers/Public/SDWebImage" "${PODS_ROOT}/Headers/Public/UMengAnalytics-NO-IDFA" "${PODS_ROOT}/Headers/Public/iOS-Slide-Menu" "$(SDKROOT)/usr/include/libxml2"
LIBRARY_SEARCH_PATHS = "$(PODS_ROOT)/EaseMobSDK/EaseMobSDK/lib" "$(PODS_ROOT)/EaseMobSDK/EaseMobSDK/lib" "$(PODS_ROOT)/EaseMobSDK/EaseMobSDK/lib" "$(PODS_ROOT)/EaseMobSDK/EaseMobSDK/lib" "$(PODS_ROOT)/EaseMobSDK/EaseMobSDK/lib" "$(PODS_ROOT)/UMengAnalytics-NO-IDFA/**"
OTHER_CFLAGS = $(inherited) -isystem "${PODS_ROOT}/Headers/Public" -isystem "${PODS_ROOT}/Headers/Public/ASIHTTPRequest" -isystem "${PODS_ROOT}/Headers/Public/CocoaLumberjack" -isystem "${PODS_ROOT}/Headers/Public/EaseMobSDK" -isystem "${PODS_ROOT}/Headers/Public/FMDB" -isystem "${PODS_ROOT}/Headers/Public/KLCircleViewController" -isystem "${PODS_ROOT}/Headers/Public/MJExtension" -isystem "${PODS_ROOT}/Headers/Public/MJRefresh" -isystem "${PODS_ROOT}/Headers/Public/Masonry" -isystem "${PODS_ROOT}/Headers/Public/Reachability" -isystem "${PODS_ROOT}/Headers/Public/RegExCategories" -isystem "${PODS_ROOT}/Headers/Public/SDWebImage" -isystem "${PODS_ROOT}/Headers/Public/UMengAnalytics-NO-IDFA" -isystem "${PODS_ROOT}/Headers/Public/iOS-Slide-Menu"
OTHER_LDFLAGS = $(inherited) -ObjC -l"EaseMobClientSDKLite_arm64" -l"EaseMobClientSDKLite_armv7" -l"EaseMobClientSDKLite_armv7s" -l"EaseMobClientSDKLite_i386" -l"EaseMobClientSDKLite_x86_64" -l"MobClickLibrary" -l"Pods-XiaoYou-ASIHTTPRequest" -l"Pods-XiaoYou-CocoaLumberjack" -l"Pods-XiaoYou-FMDB" -l"Pods-XiaoYou-KLCircleViewController" -l"Pods-XiaoYou-MJExtension" -l"Pods-XiaoYou-MJRefresh" -l"Pods-XiaoYou-Masonry" -l"Pods-XiaoYou-Reachability" -l"Pods-XiaoYou-RegExCategories" -l"Pods-XiaoYou-SDWebImage" -l"Pods-XiaoYou-iOS-Slide-Menu" -l"iconv" -l"resolv" -l"sqlite3" -l"stdc++" -l"stdc++.6" -l"xml2" -l"xml2.2" -l"z" -l"z.1" -framework "AddressBook" -framework "CFNetwork" -framework "CoreGraphics" -framework "CoreLocation" -framework "Foundation" -framework "ImageIO" -framework "MapKit" -framework "MobileCoreServices" -framework "Security" -framework "SystemConfiguration" -framework "UIKit"
OTHER_LIBTOOLFLAGS = $(OTHER_LDFLAGS)
PODS_ROOT = ${SRCROOT}/../Pods