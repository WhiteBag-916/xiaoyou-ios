GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/ASIHTTPRequest" "${PODS_ROOT}/Headers/Public/CocoaLumberjack" "${PODS_ROOT}/Headers/Public/FMDB" "${PODS_ROOT}/Headers/Public/KLCircleViewController" "${PODS_ROOT}/Headers/Public/MJExtension" "${PODS_ROOT}/Headers/Public/Reachability" "${PODS_ROOT}/Headers/Public/RegExCategories" "${PODS_ROOT}/Headers/Public/SDWebImage" "${PODS_ROOT}/Headers/Public/UMengAnalytics-NO-IDFA" "$(SDKROOT)/usr/include/libxml2"
LIBRARY_SEARCH_PATHS = "$(PODS_ROOT)/UMengAnalytics-NO-IDFA/**"
OTHER_CFLAGS = $(inherited) -isystem "${PODS_ROOT}/Headers/Public" -isystem "${PODS_ROOT}/Headers/Public/ASIHTTPRequest" -isystem "${PODS_ROOT}/Headers/Public/CocoaLumberjack" -isystem "${PODS_ROOT}/Headers/Public/FMDB" -isystem "${PODS_ROOT}/Headers/Public/KLCircleViewController" -isystem "${PODS_ROOT}/Headers/Public/MJExtension" -isystem "${PODS_ROOT}/Headers/Public/Reachability" -isystem "${PODS_ROOT}/Headers/Public/RegExCategories" -isystem "${PODS_ROOT}/Headers/Public/SDWebImage" -isystem "${PODS_ROOT}/Headers/Public/UMengAnalytics-NO-IDFA"
OTHER_LDFLAGS = $(inherited) -ObjC -l"MobClickLibrary" -l"Pods-XiaoYou-ASIHTTPRequest" -l"Pods-XiaoYou-CocoaLumberjack" -l"Pods-XiaoYou-FMDB" -l"Pods-XiaoYou-KLCircleViewController" -l"Pods-XiaoYou-MJExtension" -l"Pods-XiaoYou-Reachability" -l"Pods-XiaoYou-RegExCategories" -l"Pods-XiaoYou-SDWebImage" -l"sqlite3" -l"xml2.2" -l"z" -l"z.1" -framework "CFNetwork" -framework "CoreGraphics" -framework "ImageIO" -framework "MobileCoreServices" -framework "SystemConfiguration"
OTHER_LIBTOOLFLAGS = $(OTHER_LDFLAGS)
PODS_ROOT = ${SRCROOT}/../Pods